generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model portfolio_contact {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  message    String
  subject    String
  user_email String
  user_name  String
}

model my_proposal {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  hers_name String
  response  String
  reason    String?
}

model pickup_lines {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  content    Json
  createdAt  DateTime @default(now())
}

model pickup_line_response {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  pickup_line Json
  response    String
  createdAt   DateTime @default(now())
  created_by  String
}
